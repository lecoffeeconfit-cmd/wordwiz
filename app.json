{
  "expo": {
    "name": "WordWiz",
    "slug": "wordwiz",
    "scheme": "wordwiz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F2EFFF",
    "plugins": [
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "lecoffeeconfit",
          "project": "wordwiz"
        }
      ],
      [
      "expo-notifications",
        {
          "color": "#58CC62",
          "defaultChannel": "daily-review"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access a photo for your Community profile.",
          "microphonePermission": "WordWiz uses the microphone only when you choose voice input, so it can transcribe the spoken word and look up its definition."
        }
      ],
      "expo-web-browser",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "WordWiz uses the microphone only when you choose voice input, so it can transcribe the spoken word and look up its definition.",
          "speechRecognitionPermission": "WordWiz uses speech recognition only when you choose voice input, so it can convert your spoken word into text for lookup.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-with-quote.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#F2EFFF",
          "dark": {
            "image": "./assets/splash-icon-with-quote.png",
            "backgroundColor": "#F2EFFF"
          }
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "ios": {
      "bundleIdentifier": "com.lecoffeeconfit.wordwiz",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        },
        "NSMicrophoneUsageDescription": "WordWiz uses the microphone only when you choose voice input, so it can transcribe the spoken word and look up its definition.",
        "NSSpeechRecognitionUsageDescription": "WordWiz uses speech recognition only when you choose voice input, so it can convert your spoken word into text for lookup."
      },
      "buildNumber": "27"
    },
    "android": {
      "package": "com.lecoffeeconfit.wordwiz",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "2cacc404-4819-411d-91a3-c8086be12591"
      }
    }
  }
}
